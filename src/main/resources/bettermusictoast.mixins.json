{
	"required": true,
	"package": "de.bettermusictoast.mixin",
	"compatibilityLevel": "${java}",<% if (refmap) { %>
	"minVersion": "0.8",
	"refmap": "bettermusictoast.refmap.json",<% } %>
	"client": [
		"AbstractSoundInstanceMixin",
		"BossHealthOverlayAccessor",
		"ChannelMixin",
<% if (forge_hud_mixin) { %>		"ForgeGuiMixin",
<% } %><% if (screen_mixin) { %>		"GameRendererMixin",
<% } %>		"HudAccessor",
<% if (vanilla_toast) { %>		"NowPlayingToastMixin",
		"PauseScreenMixin",
<% } else { %>		"MinecraftMixin",
		"MusicManagerAccessor",
		"MusicManagerMixin",
<% if (stb_audio) { %>		"OggAudioStreamMixin",
<% } %><% if (options_file) { %>		"OptionsMixin",
<% } %>		"SoundEngineMixin",
		"SoundManagerAccessor",
<% } %><% if (options_list) { %>		"SimpleOptionsSubScreenAccessor",
<% } %>		"SoundOptionsScreenMixin",
		"ToastInstanceAccessor",
		"ToastManagerAccessor"<% if (vanilla_toast) { %>,
		"ToastManagerMixin"<% } %>
	],
	"injectors": {
		"defaultRequire": 1
	},
	"overwrites": {
		"requireAnnotations": true
	}
}
